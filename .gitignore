/data/
/models/
/*.parquet
/*.feather
/*.arrow

# SFT / finetuning artifacts (excluded for now)
scripts/finetuning/
agentic_issue_resolution/tools/manager_sft.py

# Root npm lock not part of this project structure
/package-lock.json

# Keep reproducible demo samples
!agentic_issue_resolution/samples/*.json
