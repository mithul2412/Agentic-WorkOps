# Runtime outputs / reports / local DB
agentic_issue_resolution/storage/*.db
agentic_issue_resolution/storage/*.json
!agentic_issue_resolution/storage/__init__.py
!agentic_issue_resolution/storage/sqlite_store.py

# App build artifacts
agentic_issue_resolution/ui/node_modules/
agentic_issue_resolution/ui/dist/
agentic_issue_resolution/ui/tsconfig.tsbuildinfo

