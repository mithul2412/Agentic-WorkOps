__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# Node artifacts
node_modules/
dist/
*.log

# Env and secrets
.env
.env.*
*.env
*.pem
*.key
*.crt
!agentic_issue_resolution/.env.example

# Local OAuth / credentials / tokens
agentic_issue_resolution/client_secret_*.json
