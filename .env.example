# Provider selectors
JIRA_PROVIDER=real
BITBUCKET_PROVIDER=real
CONFLUENCE_PROVIDER=real
TAVILY_PROVIDER=real
CALENDAR_PROVIDER=google
EMAIL_PROVIDER=google

# Model providers and model IDs
OLLAMA_BASE_URL=http://127.0.0.1:11434
MANAGER_OLLAMA_MODEL=qwen25-triage
COMMS_LLM_PROVIDER=ollama
COMMS_OLLAMA_MODEL=qwen2.5:3b-instruct
COMMS_LLM_TEMPERATURE=0.1
COMMS_LLM_MAX_TOKENS=900

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
MANAGER_OPENROUTER_MODEL=arcee-ai/trinity-large-preview:free
JUDGE_OPENROUTER_MODEL=arcee-ai/trinity-large-preview:free
COMMS_OPENROUTER_MODEL=
COMMS_OPENROUTER_API_KEY=
OPENROUTER_HTTP_REFERER=
OPENROUTER_X_TITLE=ticketops

GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
MANAGER_GROQ_MODEL=llama-3.3-70b-versatile
JUDGE_GROQ_MODEL=llama-3.3-70b-versatile
COMMS_GROQ_MODEL=
COMMS_GROQ_API_KEY=

GOOGLE_API_KEY=
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-2.5-flash
ENGINEER_GEMINI_MODEL=gemini-2.5-flash
JUDGE_GEMINI_MODEL=gemini-2.5-flash
COMMS_GEMINI_MODEL=
COMMS_GEMINI_API_KEY=
JUDGE_MIN_CONFIDENCE_FOR_SELECTOR=0.55

# LangSmith tracing
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=TicketTriage

# Tavily
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com

# Bitbucket
